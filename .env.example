# Placeholder values only. Real values come from the Homebase key store
# through the approved loader at run time. Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_DB_SCHEMA=itsupport
TRIGGER_SECRET_KEY=replace-with-trigger-secret-key
TRIGGER_PROJECT_REF=proj_sefqgwbhymcyikibqjmo
SHADOW_MODE=true
ADMIN_HEALTH_TOKEN=replace-with-admin-health-token
INTERNAL_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_VERSION=0.1.0
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TYPESAFE_API_KEY=replace-with-typesafe-api-key
SENSITIVE_THRESHOLD=0.5
E2E_MODE=false
# Slack interactivity (web app). Real values live only in the env.
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_REVIEWER_IDS=U0000000000
SLACK_CHANNEL_ID=C0000000000
LLM_MONTHLY_CALL_CAP=2000
TYPESAFE_MONTHLY_CALL_CAP=20000
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
TRIAGE_CONFIDENCE_MIN=0.7
INJECTION_THRESHOLD=0.5
NEEDS_INFO_THRESHOLD=0.5
OUTAGE_THRESHOLD=0.5
GROUNDING_MIN=0.6
LLM_API_KEY=replace-with-llm-api-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash:nitro
E2E_BASE_URL=https://e2e.example.com
CF_ACCESS_CLIENT_ID=replace-with-access-client-id
CF_ACCESS_CLIENT_SECRET=replace-with-access-client-secret
STAGING_BASE_URL=https://staging.example.com
# Live tests only (phase 4): the e2e Slack app. Values come from the key store;
# leave them empty here. Channel and user IDs are never code defaults.
# Bot token of the one Slack app
E2E_SLACK_BOT_TOKEN=
# Channel ID of the e2e review channel
E2E_SLACK_CHANNEL_ID=
# The e2e test signing secret (never the staging one)
E2E_SLACK_SIGNING_SECRET=
# User ID of the fake e2e reviewer
E2E_SLACK_REVIEWER_ID=
# Live tests only (phase 5): the dev420188 integration user (svc.itsupport) the
# tests read incidents with. Values come from the key store; leave them empty here.
# Must be exactly https://dev420188.service-now.com
E2E_SERVICENOW_INSTANCE_URL=
E2E_SERVICENOW_USERNAME=
E2E_SERVICENOW_PASSWORD=
# Live tests only (phase 5, P5-T8c): the reply email. Values come from the key
# store; leave them empty here.
# Second Resend key, full access, read only (the helper never sends)
E2E_RESEND_READ_KEY=
# The allow-listed mailbox the reply email goes to (not a secret)
E2E_REPLY_RECIPIENT=
# Slack Web API client (services/pipeline, phase 4). The bot token comes from
# the key store; leave it empty here. SLACK_CHANNEL_ID is shared with the
# web app (above).
SLACK_BOT_TOKEN=
# Optional: channel for pipeline alerts
SLACK_ALERT_CHANNEL_ID=
# How long a review card waits for a decision (1m to 7d; 2m on the E2E project)
SLACK_REVIEW_TIMEOUT=24h
# Which helpdesk the agent writes to: servicenow or builtin. Required, no default (services/pipeline
# and apps/web). The ServiceNow variables below are needed only when this is servicenow.
HELPDESK=servicenow
# ServiceNow connector (services/pipeline, phase 5). Values come from the key store.
# https://<name>.service-now.com, no path
SERVICENOW_INSTANCE_URL=https://example.service-now.com
SERVICENOW_USERNAME=svc.itsupport
# At least 12 characters
SERVICENOW_PASSWORD=replace-with-servicenow-password
# sys_id of the fallback caller (32 lower-case hex)
SERVICENOW_DEFAULT_CALLER=00000000000000000000000000000000
# Reply emails (services/pipeline, phase 5). The Resend key comes from the key store.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# One address on the verified sending domain
REPLY_FROM=help@example.com
# 1-20 distinct lower-case addresses, comma-separated, no spaces
REPLY_ALLOWED_RECIPIENTS=you@example.com
