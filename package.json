{
  "name": "ai-it-support-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "turbo run lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "build": "turbo run build",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:docker": "node apps/web/scripts/docker-smoke.mjs",
    "deploy:pipeline": "pnpm --filter \"./packages/*\" run build && pnpm --filter @ai-it-support/pipeline exec trigger deploy",
    "scan:semgrep": "node packages/shared/scripts/semgrep-scan.mjs",
    "test:mutation": "node packages/shared/scripts/mutation-gate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.39.5",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
